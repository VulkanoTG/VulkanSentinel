/.vscode

# Dependencias e artefatos locais
/node_modules
/src/generated

# Logs e backups locais
/discloud
*.log

# Ambiente local extra
/.env.dev
/.env.development
/.env.example

# Documentacao e anexos
/docs
*.md
*.zip
*.exe

